# Copy to .env.local and fill in values.
# Required for basic app + auth
DATABASE_URL=postgres://user:password@host:5432/dbname
BETTER_AUTH_SECRET=generate-a-secure-random-string
HC_IDENTITY_HOST=https://hca.dinosaurbbq.org
HC_IDENTITY_CLIENT_ID=
HC_IDENTITY_CLIENT_SECRET=
HC_IDENTITY_REDIRECT_URI=http://localhost:3000/api/auth/callback/hackclub-identity
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare R2 (image uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://your-r2-public-domain.com
# Optional
# R2_ENDPOINT=
# R2_REGION=auto

# Integrations (optional; features degrade gracefully without them)
# SLACK_BOT_TOKEN=
# Slack channel ID (e.g. C0123456789) that gets one post per project submission
# plus a thread of review events (decisions, creator replies, grant). Invite the
# bot to the channel. Unset = no staff channel posts.
# SLACK_REVIEW_CHANNEL_ID=
# AIRTABLE_API_KEY=
# AIRTABLE_BASE_ID=
# AIRTABLE_GRANTS_TABLE=
# HACKATIME_OAUTH_CLIENT_ID=
# HACKATIME_OAUTH_CLIENT_SECRET=
# HACKATIME_OAUTH_REDIRECT_URI=http://localhost:3000/api/hackatime/oauth/callback
# Hackatime admin API token — required for the devlog timeline picker feature.
# Get this from a Hack Club admin. Without it the timeline UI is silently disabled.
# HACKATIME_ADMIN_API_TOKEN=
# LOOPS_API_KEY=
# LOOPS_TRANSACTIONAL_REVIEW_EMAIL_ID=
# LOOPS_TRANSACTIONAL_SHOP_ORDER_CREATED_ADMIN_EMAIL_ID=
# LOOPS_TRANSACTIONAL_SHOP_ORDER_FULFILLED_PARTICIPANT_EMAIL_ID=
# Sent when an admin denies a shop order. Variables: participant_name, order_id, item_name, denial_reason, denied_at, shop_url
# LOOPS_TRANSACTIONAL_SHOP_ORDER_DENIED_PARTICIPANT_EMAIL_ID=
# Sent to every admin + reviewer when a project enters review. Variables: project_name, creator_name, project_description, review_url, submitted_at, is_resubmission
# LOOPS_TRANSACTIONAL_PROJECT_SUBMITTED_STAFF_EMAIL_ID=

# Automated Slack nudges (src/lib/notifications/nudges). Run daily by a Coolify
# scheduled task inside the app container: `bun scripts/nudges.js --send`.
# Without NUDGES_ENABLED=true every run is a dry run (plans, sends nothing).
# NUDGES_ENABLED=false
# Max DMs per run (default 200; 1 msg/s, so keep the task timeout above ~4 min).
# NUDGES_MAX_PER_RUN=200
# Comma-separated Slack user IDs: when set, sends go ONLY to these (test mode).
# NUDGES_TEST_SLACK_IDS=
# Slack user ID people can DM to stop messages (mentioned in the footer of every nudge and every /admin/messages send).
# NUDGES_CONTACT_SLACK_ID=

# Telescreen (Robert) fraud review (src/lib/telescreen). Every creator submission
# is sent to Robert; a fraud score of 1–4 rejects and dismisses the project, and
# grants are blocked until the submission is scored 5+. Unset = disabled.
# API key: Robert → your event → Settings → API keys (starts with ysws_).
# ROBERT_API_KEY=
# Signing secret shown once when you set the outcome webhook URL to
# https://<carnival host>/api/webhooks/telescreen (Settings → Outcome webhook).
# ROBERT_WEBHOOK_SECRET=
# Optional override (default https://telescreen.hackclub.com).
# ROBERT_API_BASE_URL=

# Optional: Hackatime Billy review tool URL (default: https://joe.fraud.hackclub.com/billy)
# NEXT_PUBLIC_HACKATIME_BILLY_URL=
